# =====================================================================
#  How configuration is resolved  (see config.py)
# =====================================================================
# Every key below is resolved as:  OS env var  ->  GCP Secret Manager
# secret of the SAME name  ->  code default.
#
# In production NOTHING here is set as an env var except GCP_PROJECT_ID and
# GCS_BUCKET_NAME (injected by cloudbuild.yaml); the real values live in
# Secret Manager, one secret per key (secret id == the key name).
#
# This .env file is only for LOCAL development - config.py load_dotenv()s it
# so you can run without touching Secret Manager.
#
# GCP_PROJECT_ID=private-data-store-dev
# GCS_BUCKET_NAME=co-ordinate-gmail-attachments

# =====================================================================
#  Coordinate mailbox
# =====================================================================
COORDINATE_EMAIL=coordinator@example.com

# Which providers the coordinator activates:
#   auto  -> detect from the keys filled in below
#   or a comma list: agentmail,gmail,m365
ACTIVE_PROVIDERS=auto

# Bearer token guarding POST /admin/*  (Cloud Scheduler -> webhook setup/renew).
# Unset -> the admin API returns 503. Header: X-Admin-Token: <value>
ADMIN_TOKEN=

# Shared HTTP server
HOST=0.0.0.0
PORT=8080

# =====================================================================
#  AgentMail        (webhook: event message.received)
# =====================================================================
# In production these four live in ONE Secret Manager secret, AGENTMAIL_CONFIG,
# a JSON string:
#   {"AGENTMAIL_API_KEY":"am_...","AGENTMAIL_INBOX_ID":"you@agentmail.to",
#    "AGENTMAIL_WEBHOOK_URL":"https://.../agentmail/webhook","AGENTMAIL_WEBHOOK_SECRET":""}
# Local dev: set the individual vars below, OR paste the JSON on one line as
#   AGENTMAIL_CONFIG={...}
# An individual env var still wins over the JSON field.
AGENTMAIL_API_KEY=am_us_inbox_b293608950ce499ab0e9c1950608df739ec2ba7b2a08cb165293f8bb70bf8a23
AGENTMAIL_INBOX_ID=zee.coordinator@agentmail.to
# public https URL that reaches this app:
#   standalone   -> https://your-domain.com/webhook
#   coordinator  -> https://your-domain.com/agentmail/webhook
AGENTMAIL_WEBHOOK_URL=https://your-domain.com/agentmail/webhook
# signing secret shown once when the webhook is created (starts with whsec_)
AGENTMAIL_WEBHOOK_SECRET=

# =====================================================================
#  Gmail / Google Workspace   (users.watch -> Pub/Sub push)
# =====================================================================
# EVERYTHING Gmail needs is ONE Secret Manager secret, GOOGLE_MAIL, a JSON object:
#   {
#     "coordinator_mail": "coordinator@example.com",
#     "client_id":     "5452...apps.googleusercontent.com",
#     "client_secret": "GOCSPX-...",
#     "refresh_token": "1//04...",
#     "token_uri":     "https://oauth2.googleapis.com/token",
#     "pubsub_topic":  "projects/your-project/topics/gmail-inbox",
#     "push_token":    ""   # optional; auto-generated if omitted
#   }
# Local dev: paste that JSON on one line:
#   GOOGLE_MAIL={"coordinator_mail":"...","client_id":"...","client_secret":"...","refresh_token":"...","token_uri":"https://oauth2.googleapis.com/token","pubsub_topic":"projects/your-project/topics/gmail-inbox","push_token":""}
#
# The history cursor is a fixed local file (gmail_last_history.json) - no env var.
# Push subscription endpoint:  https://<host>/gmail/webhook?token=<push_token>
# There are no separate GMAIL_* env vars - everything is in GOOGLE_MAIL.

# =====================================================================
#  Microsoft 365 / Outlook    (Graph change-notification subscription)
# =====================================================================
# All MS_* values live in ONE Secret Manager secret, MS365_Mail, a JSON object:
#   {
#     "MS_TENANT_ID": "your-tenant-id",
#     "MS_CLIENT_ID": "your-client-id",
#     "MS_CLIENT_SECRET": "your-client-secret",
#     "MS_MAILBOX": "coordinator@example.com",
#     "MS_NOTIFICATION_URL": "https://your-domain.com/m365/webhook",
#     "MS_CLIENT_STATE": "your-random-secret"
#   }
# config.get("MS_TENANT_ID") reads the field out; an individual env var overrides.
# Local dev: set the MS_* vars below, OR paste the JSON on one line as
#   MS365_Mail={"MS_TENANT_ID":"...","MS_CLIENT_ID":"...","MS_CLIENT_SECRET":"...","MS_MAILBOX":"...","MS_NOTIFICATION_URL":"https://your-domain.com/m365/webhook","MS_CLIENT_STATE":"..."}
# The subscription id is cached in a fixed local file (m365_subscription.json).
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_MAILBOX=coordinator@example.com
MS_NOTIFICATION_URL=https://your-domain.com/m365/webhook
MS_CLIENT_STATE=pick-a-random-secret-string

# =====================================================================
#  Database  (GCP Cloud SQL for PostgreSQL)
# =====================================================================
# In production every DB_* value lives in ONE Secret Manager secret named
#   COORDINATOR_DB_CONNECTION
# whose payload is a JSON string:
#   {
#     "DB_HOST": "127.0.0.1", "DB_PORT": 5432, "DB_NAME": "", "DB_USER": "",
#     "DB_PASSWORD": "", "DB_SSLMODE": "", "DATABASE_URL": "",
#     "DB_POOL_SIZE": 5, "DB_MAX_OVERFLOW": 10, "DB_POOL_RECYCLE": 1800,
#     "DB_ECHO": false
#   }
# config.get("DB_HOST") reads the "DB_HOST" field out of it automatically.
#
# For LOCAL dev, either set the individual DB_* vars below, OR paste the same
# JSON as a single line:
#   COORDINATOR_DB_CONNECTION={"DB_HOST":"127.0.0.1","DB_PORT":5432,"DB_NAME":"email_coordination","DB_USER":"app_user","DB_PASSWORD":"secret"}
# An individual DB_* env var still wins over the JSON field.

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=email_coordination
DB_USER=app_user
DB_PASSWORD=

# --- SSL mode (optional) -------------------------------------------------
# Passed through to libpq/psycopg as `sslmode`. Leave commented for the
# libpq default (`prefer`). Possible values, weakest -> strongest:
#   disable      never use SSL. Plain TCP only. Local dev / trusted socket.
#   allow        try non-SSL first, use SSL only if the server rejects it.
#   prefer       (default) try SSL first, silently fall back to non-SSL.
#   require      SSL is mandatory, but the server cert is NOT verified.
#                -> minimum for GCP Cloud SQL over a direct PUBLIC IP.
#   verify-ca    SSL mandatory + cert must be signed by a trusted CA.
#                Needs a CA file (DATABASE_URL ...&sslrootcert=server-ca.pem).
#   verify-full  SSL mandatory + trusted CA + hostname matches the cert.
#                Strongest; use for any production public-internet connection.
# When to leave it blank: Cloud SQL Auth Proxy, the Python Connector, a Unix
# socket (DB_HOST=/cloudsql/<proj>:<region>:<instance>), or private IP --
# TLS is already handled and you connect to localhost.
# DB_SSLMODE=require

# Optional: a full URL overrides every DB_* part above
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
# Pool tuning (optional)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_ECHO=false

# =====================================================================
#  LLM agents  (llm-agents/, agentkit.py)
# =====================================================================
# No GLOBAL_/DEFAULT_ vars and no built-in default model. Every agent reads ONE
# model-profile JSON secret. Its name comes from LLM_PROFILE (default GEMINI_LITE):
#   GEMINI_LITE = {
#     "MODEL":          "gemini/gemini-3.1-flash-lite",
#     "TEMPERATURE":    0,
#     "MAX_TOKENS":     8192,
#     "GEMINI_API_KEY": "..."        # or "API_KEY" / "API_BASE"
#   }
# Local dev: paste it on one line:
#   GEMINI_LITE={"MODEL":"gemini/gemini-3.1-flash-lite","TEMPERATURE":0,"MAX_TOKENS":8192,"GEMINI_API_KEY":"..."}
# LLM_PROFILE=GEMINI_LITE
#
# Per-agent overrides still win (prefix = agent name upper-cased), e.g.:
# CAMPAIGN_CREATE_MODEL=gemini/gemini-3.1-pro
# CAMPAIGN_CREATE_TEMPERATURE=0.2
